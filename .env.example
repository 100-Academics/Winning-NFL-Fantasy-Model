# Local secrets — NOT committed (see .gitignore). Copy to .env and fill in.
#
# CFBD_API_KEY=CollegeFootballData.com API key (free tier).
#   Get one at https://cfbd.com/developers/ (free account).
#   Used by Phase 5.5 (rookie prior) for college player season stats + SP+.
CFBD_API_KEY=

# FANTASYPROS_API_KEY=FantasyPros public API key (free tier: top-10/position/week,
#   rate-limited). Used by src.fetch_fantasypros + src.compare_fantasypros for the
#   head-to-head vs FantasyPros consensus. Get one at https://fantasypros.com/api-data/
# FANTASYPROS_API_KEY=

# ESPN_SWID=ESPN SWID cookie (enables the fantasy player-projection endpoint).
#   Used optionally for an ESPN baseline in the head-to-head.
# ESPN_SWID=
